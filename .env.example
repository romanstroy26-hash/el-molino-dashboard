# Скопируй этот файл в ".env" (без .example) в этой же папке, чтобы
# переключить систему на облачную базу данных вместо локального файла.
# Без .env -- всё работает как раньше, на локальном el_molino.db.
#
# Как получить строку подключения (бесплатно, ~5 минут):
#   1. Зарегистрируйся на supabase.com (или neon.tech -- тоже подойдёт)
#   2. Создай новый проект (New Project), придумай пароль для базы
#   3. Наверху страницы проекта нажми зелёную кнопку Connect
#   4. В окне выбери плитку "Direct Connection" (не MCP и не Server)
#   5. Внутри неё выбери режим Session pooler (не Direct connection --
#      тот требует IPv6)
#   6. Скопируй строку сюда, вставь свой пароль вместо [YOUR-PASSWORD]

DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres

# A long, private value used to sign customer login sessions.
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret

# Private key for the back-office routes that create rewards and campaigns.
ADMIN_API_KEY=replace-with-a-second-long-random-secret

# Private key used only by the cashier or a trusted back-office purchase importer.
CASHIER_API_KEY=replace-with-a-third-long-random-secret

# LabsMobile: copy the username from your account and create a fresh API token.
# Keep the real token only in .env, never in source files.
LABSMOBILE_USERNAME=your-labsmobile-username
LABSMOBILE_API_TOKEN=replace-with-a-new-labsmobile-token
# Optional during provider testing: 1 simulates sending without delivering SMS.
# Leave unset or set to 0 for real delivery.
# LABSMOBILE_TEST_MODE=1
