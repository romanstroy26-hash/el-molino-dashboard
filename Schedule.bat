rem  для загрузки больше открывать не нужно вообще.
rem
rem  Вся настройка -- в programar_tarea.ps1 рядом. Здесь только запуск.
rem ===========================================================================

echo ============================================================
echo   El Molino -- сторож в автозагрузку Windows
echo ============================================================
echo.
echo Сейчас будет создана задача в планировщике Windows: сторож будет
