@echo off
chcp 65001 >nul
cd /d "%~dp0"

rem ===========================================================================
rem  Schedule.bat -- поставить сторожа в автозагрузку Windows (один раз).
rem
rem  После этого vigilar.py запускается сам при каждом входе в Windows,
rem  без единого окна на экране, и работает постоянно: положил файл в
rem  папку data (или "Загрузки", или в CARPETAS_EXTRA из .env) -- он в
